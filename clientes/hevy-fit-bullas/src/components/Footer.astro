---
import { direccionCompleta, enlaceWhatsapp } from '@plantilla/lib/ficha';
import type { FichaHevy } from '../lib/datos';
import Icono from './Icono.astro';
import Logo from './Logo.astro';

interface Props {
  ficha: FichaHevy;
  /** Solo en producción y si el cliente lo acepta (§10). */
  credito?: { marca: string; url: string } | null;
  titular?: string;
  nif?: string;
}
const { ficha, credito = null, titular = '[TITULAR]', nif = '[NIF]' } = Astro.props;
const whatsapp = enlaceWhatsapp(ficha, `Hola, quiero información sobre ${ficha.marca}.`);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const enlace = 'inline-flex min-h-11 items-center gap-3 hover:text-neon';
const resumen = 'inline-flex min-h-11 cursor-pointer list-none items-center underline decoration-noche-borde underline-offset-4 hover:text-neon';
---

<footer id="contacto" class="px-4 pb-32 pt-4 text-hueso sm:px-8 md:pb-14">
  <div class="mx-auto max-w-6xl border-t border-noche-borde pt-10">
    <div class="grid gap-10 md:grid-cols-[1fr_auto]">
      <div>
        <Logo class="h-24 w-auto sm:h-28" neon />
        <p class="m-0 mt-4 text-hueso-tenue">{ficha.nombre}<br />{direccionCompleta(ficha)}</p>
        <p class="m-0 mt-1 text-hueso-tenue">Más de {ficha.experiencia_anios} años de experiencia.</p>
        <p class="mt-3"><a href={`${base}/social-club/`} class="inline-flex min-h-11 items-center border-b border-noche-borde hover:text-neon">Social Club</a></p>
      </div>
      <ul class="m-0 list-none space-y-1 p-0 text-lg">
        <li>
          <a href={whatsapp} class={enlace} target="_blank" rel="noopener">
            <Icono nombre="whatsapp" class="size-5 text-neon" />
            WhatsApp
          </a>
        </li>
        <li>
          <a href={`mailto:${ficha.email}`} class={enlace}>
            <Icono nombre="correo" class="size-5 text-neon" />
            {ficha.email}
          </a>
        </li>
        <li>
          <a href={ficha.instagram} class={enlace} target="_blank" rel="noopener">
            <Icono nombre="instagram" class="size-5 text-neon" />
            @hevy_fit
          </a>
        </li>
      </ul>
    </div>

    <div class="mt-10 border-t border-noche-borde pt-4 text-sm text-hueso-tenue">
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <details>
          <summary class={resumen}>Aviso legal</summary>
          <div class="mt-3 max-w-[70ch] space-y-2">
            <p>Titular de esta web: {titular}, con NIF {nif}, con domicilio en {direccionCompleta(ficha)}. Contacto: {ficha.email}.</p>
            <p>El contenido de esta web (textos, fotos y marca) pertenece a su titular. No se permite copiarlo sin permiso.</p>
          </div>
        </details>
        <details id="privacidad" data-abre-privacidad>
          <summary class={resumen}>Privacidad</summary>
          <div class="mt-3 max-w-[70ch] space-y-2">
            <p>
              Responsable: {titular}. Si te inscribes en el formulario de esta web o nos escribes por WhatsApp o por correo, tratamos tus
              datos solo para darte de alta como interesado, contactar contigo y gestionar tu inscripción, con tu consentimiento y según
              el Reglamento (UE) 2016/679.
            </p>
            <p>
              Los datos del formulario se guardan en Trainingym, el programa de gestión del centro, y en nuestro servidor de Cloudflare,
              donde se borran pasado un año. No se ceden a nadie más. Solo te enviaremos novedades por email si marcas esa casilla.
            </p>
            <p>Si te inscribes en hevyfitbullas.es, la plataforma de reservas del centro, se aplica también su propia política de privacidad.</p>
            <p>Puedes pedir acceso, corrección o borrado de tus datos escribiendo a {ficha.email}.</p>
          </div>
        </details>
        <details>
          <summary class={resumen}>Cookies</summary>
          <div class="mt-3 max-w-[70ch] space-y-2">
            <p>Esta web no usa cookies propias ni de seguimiento. Si pulsas «Ver el mapa», se carga un mapa de Google y Google puede usar sus propias cookies.</p>
          </div>
        </details>
      </div>
    </div>

    <p class="m-0 mt-8 text-sm text-hueso-tenue">
      © {new Date().getFullYear()} {ficha.marca}.
      {credito && (
        <>
          {' '}Web hecha por <a href={credito.url} class="underline hover:text-neon">{credito.marca}</a>.
        </>
      )}
    </p>
  </div>
</footer>

<script>
  // Los enlaces a #privacidad (p. ej. desde el formulario) abren el desplegable.
  const abrir = () => { if (location.hash === '#privacidad') document.querySelector<HTMLDetailsElement>('#privacidad')?.setAttribute('open', ''); };
  addEventListener('hashchange', abrir);
  abrir();
</script>
