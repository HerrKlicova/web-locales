---
// Social Club: lo que organizamos fuera de las clases. Las fotos y los vídeos de cada cita.
import Layout from '../../layouts/Layout.astro';
import Cabecera from '../../components/Cabecera.astro';
import Footer from '../../components/Footer.astro';
import BarraFija from '../../components/BarraFija.astro';
import Icono from '../../components/Icono.astro';
import { enlaceWhatsapp } from '@plantilla/lib/ficha';
import type { FichaHevy } from '../../lib/datos';
import fichaJson from '../../../ficha.json';
import { Picture } from 'astro:assets';
import { FOTOS_EVENTOS } from '../../lib/fotos';

const ficha = fichaJson as unknown as FichaHevy;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const whatsapp = enlaceWhatsapp(ficha, 'Hola, quiero información sobre el Social Club de Hevy Fit.');

const titulo = `Social Club — ${ficha.marca}, ${ficha.pueblo}`;
const descripcion = `El Social Club de Hevy Fit en Bullas: cenas, talleres, salidas y entrenamientos al aire libre. Fotos y vídeos de todo lo que organizamos.`;
const demo = import.meta.env.PRODUCCION !== 'true';
---

<Layout titulo={titulo} descripcion={descripcion} demo={demo}>
  <Cabecera ficha={ficha} />

  <main id="contenido">
    <p class="mx-auto max-w-6xl px-4 pt-4 sm:px-8">
      <a href={`${base}/`} class="inline-flex min-h-11 items-center text-hueso-tenue hover:text-hueso">Volver a la portada</a>
    </p>

    <section aria-labelledby="social-titulo" class="luz-magenta px-4 py-12 sm:px-8 md:py-20">
      <div class="mx-auto max-w-6xl">
        <div class="reveal max-w-[44rem]">
          <div class="led w-16" aria-hidden="true"></div>
          <h1 id="social-titulo" class="rotulo m-0 mt-5 text-4xl sm:text-6xl">Social Club</h1>
          <p class="mt-6 max-w-[52ch] text-lg leading-snug text-hueso-tenue sm:text-xl">
            {ficha.experiencia_anios} años de trayectoria dan para mucho más que clases: cenas, talleres, salidas y
            entrenamientos al aire libre. Aquí guardamos las fotos y los vídeos de cada cita.
          </p>
        </div>


        <div class="reveal mt-10 md:mt-14">
          <h2 class="rotulo m-0 text-2xl sm:text-3xl">El Social Club en fotos</h2>
          <ul class="escalonado mt-6 grid list-none grid-cols-2 gap-3 p-0 md:grid-cols-3 md:gap-4">
            {
              FOTOS_EVENTOS.map((f) => (
                <li class="foto-zoom overflow-hidden rounded-xl">
                  <Picture
                    src={f.src}
                    alt={f.alt}
                    formats={['avif', 'webp']}
                    widths={[360, 540, 760, 1000]}
                    sizes="(min-width: 768px) 33vw, 50vw"
                    loading="lazy"
                    decoding="async"
                    pictureAttributes={{ class: 'block' }}
                    class="block aspect-[3/4] h-auto w-full object-cover"
                  />
                </li>
              ))
            }
          </ul>
          <p class="mt-6 max-w-[60ch] text-hueso-tenue">Iremos añadiendo las fotos y los vídeos de cada cita nueva.</p>
          <a
            href={whatsapp}
            class="mt-4 inline-flex min-h-12 items-center justify-center gap-2.5 rounded-full border-2 border-(--borde) px-6 font-bold text-hueso transition-colors hover:border-hueso"
            target="_blank"
            rel="noopener"
          >
            <Icono nombre="whatsapp" class="size-5" />
            Preguntar por la próxima cita
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer ficha={ficha} titular={ficha.titular} nif={ficha.nif} />
  <BarraFija ficha={ficha} />
</Layout>
