---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/* Foto de sección con el barrido atado al scroll (global.css, .barrido-scroll): al entrar en
   pantalla la línea amarilla la cruza y deja detrás el color. Sin soporte de
   animation-timeline o con reducción de movimiento, la foto en color y quieta.
   Lazy, con width y height (§4). La capa en blanco y negro usa el mismo srcset: una descarga. */
interface Props {
  src: ImageMetadata;
  alt: string;
  pie?: string;
  sizes: string;
  class?: string;
}
const { src, alt, pie, sizes, class: clase } = Astro.props;
const ANCHOS = [360, 540, 720, 960, 1200];
const [avif, webp] = await Promise.all([
  getImage({ src, format: 'avif', widths: ANCHOS, width: 1200, quality: 52 }),
  getImage({ src, format: 'webp', widths: ANCHOS, width: 1200, quality: 64 }),
]);
const alto = Math.round((1200 * src.height) / src.width);
---

<figure class:list={['m-0', clase]}>
  <div class="barrido barrido-scroll marco-foto" style={`aspect-ratio: ${src.width} / ${src.height}`}>
    <picture>
      <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
      <img src={webp.src} srcset={webp.srcSet.attribute} sizes={sizes} width="1200" height={alto} alt={alt} loading="lazy" decoding="async" />
    </picture>
    <div class="barrido-capa" aria-hidden="true">
      <div class="barrido-foto">
        <picture>
          <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
          <img src={webp.src} srcset={webp.srcSet.attribute} sizes={sizes} width="1200" height={alto} alt="" loading="lazy" decoding="async" />
        </picture>
      </div>
    </div>
  </div>
  {pie && <figcaption class="mt-3 text-[0.9375rem] text-sombra">{pie}</figcaption>}
</figure>

<style>
  .marco-foto { background: var(--color-placa); }
  .marco-foto img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
