---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Ficha } from '@plantilla/lib/ficha';
import { filasManianaTarde } from '../lib/horario';

/**
 * El horario, partido en mañana y tarde como el vinilo de la puerta de su local («Mañanas: 09:30 a
 * 13:30 / Tardes: 16:30 a 21:00»). Cada mitad en su paño. Al llegar, se enciende la fila de hoy,
 * con un «hoy» en rojo (el único rojo de la interfaz, aparte del anillo de foco). Los datos salen
 * tal cual de su ficha de Google; todo está escrito en el HTML, el JS solo marca el día
 * (Estado.astro).
 * La foto del sillón vacío va detrás de cuatro paños de cristal, como la portada.
 */
interface Props { ficha: Ficha; foto: ImageMetadata }
const { ficha, foto } = Astro.props;
const filas = filasManianaTarde(ficha);
const mitades = [
  { clave: 'manana', titulo: 'Por la mañana' },
  { clave: 'tarde', titulo: 'Por la tarde' },
] as const;
---

<section id="horario" class="panos horario" aria-labelledby="horario-titulo">
  <div class="pano h-titulo">
    <h2 id="horario-titulo" class="titular h2-bloque">Horario</h2>
    <p class="h-hoy" data-hoy hidden></p>
    <p class="h-nota">Mejor con cita: por WhatsApp o llamando.</p>
  </div>

  {
    mitades.map((m) => (
      <div class={`pano h-mitad h-${m.clave}`}>
        <h3 class="titular h-h3">{m.titulo}</h3>
        <dl class="h-lista">
          {filas.map((f) => (
            <div class="h-fila" data-dias={f.indices.join(',')} data-tramo={m.clave}>
              <dt>{f.dias}</dt>
              <dd class="tabular-nums">{f[m.clave] ?? 'Cerrado'}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))
  }

  <!-- La ventana: la foto detrás y los vidrios encima, que dibujan los perfiles. -->
  <div class="pano-claro h-foto">
    <Picture
      src={foto}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200]}
      sizes="(min-width: 900px) 50vw, 100vw"
      alt="El sillón rojo de peluquero, vacío, con la capa azul marino doblada en el brazo"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="vidrio h-v1" aria-hidden="true"></div>
  <div class="vidrio h-v2" aria-hidden="true"></div>
  <div class="vidrio h-v3" aria-hidden="true"></div>
  <div class="vidrio h-v4" aria-hidden="true"></div>
</section>

<style>
  .h-titulo { display: flex; flex-direction: column; gap: 0.9rem; }
  .h-hoy { margin: 0; font-size: 1.1rem; font-weight: 700; line-height: 1.35; }
  .h-nota { margin: 0; margin-top: auto; font-size: 1.02rem; line-height: 1.35; color: var(--color-azul-tenue); }
  .h-h3 { margin: 0 0 0.9rem; font-size: clamp(1.15rem, 1.5vw, 1.45rem); }
  .h-lista { margin: 0; }
  .h-mitad { isolation: isolate; }
  .h-fila {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.15rem 1rem;
    padding: 0.6rem 0.65rem;
    margin-inline: -0.65rem;
    border-top: 1px solid rgb(27 47 68 / 0.18);
  }
  .h-fila dt { font-size: 1.02rem; }
  .h-fila dd { margin: 0; font-size: 1.08rem; font-weight: 700; }
  .h-fila.ahora dd { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.3em; }

  /* La fila de hoy se enciende: una franja de luz detrás, como un tubo que se prende, y un «hoy»
     en rojo junto al día. Llega con el paño y un poco después que él. */
  .h-fila::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(255 255 255 / 0.95), rgb(255 255 255 / 0.55));
    box-shadow: 0 0 18px 2px rgb(255 255 255 / 0.9);
    opacity: 0;
    transition: opacity 750ms var(--ease-luz) 350ms;
  }
  .h-fila.hoy::before { opacity: 1; }
  .h-fila.hoy dt { font-weight: 800; }
  /* Decorativo: la fila ya lleva aria-current="date". */
  .h-fila.hoy dt::after { content: " · hoy"; color: var(--color-rojo); }
  .pano.apagado .h-fila.hoy::before { opacity: 0; transition: none; }

  /* Móvil: título a lo ancho; mañana | tarde; la ventana a lo ancho, en dos paños. */
  .h-titulo { grid-column: 1 / -1; }
  .h-foto { grid-column: 1 / 3; grid-row: 3; aspect-ratio: 16 / 10; }
  .h-v1 { grid-area: 3 / 1; }
  .h-v2 { grid-area: 3 / 2; }
  .h-v3, .h-v4 { display: none; }

  /* Escritorio: la ventana a la izquierda (2 × 2 paños); el título arriba a la derecha y debajo
     las dos mitades. Al revés que servicios y opiniones, para que las fotos bajen en zigzag. */
  @media (min-width: 900px) {
    .h-foto { grid-area: 1 / 1 / 3 / 3; aspect-ratio: auto; min-height: 30rem; }
    .h-v1 { grid-area: 1 / 1; }
    .h-v2 { grid-area: 1 / 2; }
    .h-v3 { display: block; grid-area: 2 / 1; }
    .h-v4 { display: block; grid-area: 2 / 2; }
    .h-titulo { grid-area: 1 / 3 / 2 / 5; }
    .h-manana { grid-area: 2 / 3; }
    .h-tarde { grid-area: 2 / 4; }
  }
</style>
