---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { enlaceWhatsapp } from '@plantilla/lib/ficha';
import type { FichaHevy } from '../lib/datos';
import Icono from './Icono.astro';
import Logo from './Logo.astro';

interface Props {
  ficha: FichaHevy;
  imagen: ImageMetadata; // vertical 3:4
  alt: string;
}
const { ficha, imagen, alt } = Astro.props;

const sizes = '(min-width: 1024px) 50vw, 100vw';
const avif = await getImage({ src: imagen, format: 'avif', widths: [480, 780, 1100, 1500], width: 1100 });
const webp = await getImage({ src: imagen, format: 'webp', widths: [480, 780, 1100, 1500], width: 1100 });

const whatsapp = enlaceWhatsapp(ficha, `Hola, quiero información sobre ${ficha.marca}.`);
const enlaces = [
  ['#tarifas', 'Tarifas'],
  ['#horarios', 'Horarios'],
  ['#salas', 'Salas'],
  ['#donde', 'Dónde'],
];
---

<header class="relative text-hueso" data-hero data-sala="noche">
  <div class="mx-auto flex max-w-[90rem] items-center justify-between gap-6 px-4 py-4 sm:px-8">
    <a href="#" class="inline-flex min-h-11 items-center" aria-label="Hevy Fit, inicio">
      <Logo class="h-12 w-auto sm:h-14" neon />
    </a>
    <nav aria-label="Secciones" class="hidden items-center gap-1 md:flex">
      {enlaces.map(([href, texto]) => (
        <a href={href} class="inline-flex min-h-11 items-center px-3 text-hueso-tenue transition-colors hover:text-hueso">{texto}</a>
      ))}
      <a
        href={ficha.web_reservas}
        class="ml-3 inline-flex min-h-11 items-center rounded-full bg-neon px-5 font-bold text-noche transition-colors hover:bg-hueso"
        target="_blank"
        rel="noopener"
      >
        Reservar
      </a>
    </nav>
  </div>

  <div class="mx-auto grid max-w-[90rem] lg:min-h-[calc(100dvh-5.5rem)] lg:grid-cols-2">
    <div class="flex flex-col justify-center px-4 pb-10 pt-6 sm:px-8 sm:pt-10 lg:pb-16 lg:pr-12 lg:pt-8">
      <h1 class="rotulo m-0 text-[2.5rem] sm:text-6xl lg:text-[3.75rem] xl:text-[4.25rem]">
        Pilates, Barre y fuerza en Bullas.
      </h1>
      <p class="mt-6 max-w-[42ch] text-lg leading-snug text-hueso-tenue sm:text-xl lg:mt-8" data-entra>
        Gimnasio boutique con cuatro salas: Pilates con aparatos, estudio de Barre, centro de fuerza y
        entrenamiento en grupo. En la avenida Luis de los Reyes, 6.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap" data-entra>
        <a
          href={ficha.web_reservas}
          class="inline-flex min-h-13 items-center justify-center rounded-full bg-neon px-7 text-lg font-bold text-noche transition-colors hover:bg-hueso"
          target="_blank"
          rel="noopener"
        >
          Reservar
        </a>
        <a
          href={whatsapp}
          class="inline-flex min-h-13 items-center justify-center gap-2.5 rounded-full border-2 border-noche-borde px-6 text-lg font-bold text-hueso transition-colors hover:border-hueso"
          target="_blank"
          rel="noopener"
        >
          <Icono nombre="whatsapp" class="size-6" />
          Escribir por WhatsApp
        </a>
      </div>
      <p class="mt-6 max-w-[42ch] text-hueso-tenue" data-entra>
        Las reservas se hacen en hevyfitbullas.es, la app del centro. Matrícula única de 10 €, válida para todas las actividades.
      </p>
    </div>

    <!-- La sala de Pilates: la luz cálida del centro. Visible desde el primer frame: es el LCP. -->
    <div class="relative overflow-hidden lg:min-h-full">
      <picture>
        <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
        <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
        <img
          src={webp.src}
          width={imagen.width}
          height={imagen.height}
          alt={alt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="block aspect-[4/5] h-auto w-full object-cover sm:aspect-[4/3] lg:absolute lg:inset-0 lg:aspect-auto lg:h-full"
          data-foto
        />
      </picture>
    </div>
  </div>
  <div class="led luz-magenta origin-left" aria-hidden="true" data-led></div>
</header>

<script>
  import gsap from 'gsap';

  // Un solo momento orquestado: la entrada del hero (§5). Nada parte de opacity 0:
  // el titular y la foto se ven desde el primer frame; el resto solo se desplaza.
  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero) return;
    const foto = hero.querySelector<HTMLElement>('[data-foto]');
    const led = hero.querySelector<HTMLElement>('[data-led]');
    const entran = hero.querySelectorAll<HTMLElement>('[data-entra]');
    if (!foto) return;

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    tl.from(foto, { scale: 1.06, duration: 1.6, ease: 'power2.out' }, 0)
      .from(entran, { y: 14, duration: 0.7, stagger: 0.08 }, 0)
      .from(led, { scaleX: 0, duration: 0.9, ease: 'power2.inOut' }, 0.2);
  });
</script>
