---
import type { FichaHevy } from '../lib/datos';
import Icono from './Icono.astro';

interface Props { ficha: FichaHevy }
const { ficha } = Astro.props;
const valoracion = ficha.valoracion.toLocaleString('es-ES', { minimumFractionDigits: 1 });
---

<section id="resenas" aria-labelledby="resenas-titulo" data-sala="noche" class="bg-hueso px-4 py-16 text-tinta sm:px-8 md:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <h2 id="resenas-titulo" class="rotulo m-0 text-3xl sm:text-5xl">Lo que dicen en Google</h2>
      <p class="m-0 flex items-center gap-3 text-lg">
        <span class="flex gap-0.5 text-neon-tinta" role="img" aria-label={`${valoracion} de 5 estrellas`}>
          {Array.from({ length: 5 }).map(() => <Icono nombre="estrella" class="size-5" />)}
        </span>
        <span class="tabular-nums"><strong>{valoracion}</strong> con {ficha.num_resenas} reseñas</span>
      </p>
    </div>

    <ul class="escalonado mt-10 grid list-none gap-x-10 gap-y-10 p-0 md:mt-14 md:grid-cols-2">
      {
        ficha.resenas.map((r) => (
          <li class="flex flex-col border-t-2 border-tinta pt-5">
            <blockquote class="m-0 flex-1 text-lg leading-snug md:text-xl">
              <p class="m-0">«{r.texto}»</p>
            </blockquote>
            <p class="m-0 mt-4 flex items-center gap-3 font-bold">
              <span class="flex gap-0.5 text-neon-tinta" role="img" aria-label={`${r.estrellas} de 5 estrellas`}>
                {Array.from({ length: r.estrellas }).map(() => <Icono nombre="estrella" class="size-4" />)}
              </span>
              {r.autor}
            </p>
          </li>
        ))
      }
    </ul>

    <p class="reveal mt-10">
      <a
        href={ficha.maps_url}
        class="inline-flex min-h-11 items-center gap-2 border-b-2 border-tinta text-lg font-bold hover:border-neon-tinta hover:text-neon-tinta"
        target="_blank"
        rel="noopener"
      >
        <Icono nombre="google" class="size-5" />
        Ver las {ficha.num_resenas} reseñas en Google
      </a>
    </p>
  </div>
</section>
