---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { enlaceWhatsapp } from '@plantilla/lib/ficha';
import { NOVEDAD, type FichaHevy } from '../lib/datos';
import Icono from './Icono.astro';
import Cabecera from './Cabecera.astro';

/**
 * Hero: la recepción es el fondo de toda la primera pantalla, velada, y el titular va encima.
 * Al entrar por la puerta la vista gira despacio de izquierda (pared de listones, espejos y césped)
 * a derecha (mostrador con el neón): las dos fotos se superponen y la segunda se funde sobre la
 * primera mientras ambas siguen desplazándose, como un plano con disolvencia.
 */
interface Props {
  ficha: FichaHevy;
  izquierda: ImageMetadata; // lo que se ve a la izquierda al entrar: listones, espejos y césped
  derecha: ImageMetadata; // lo que se ve a la derecha: el mostrador y el neón
}
const { ficha, izquierda, derecha } = Astro.props;

// Las fotos miden un 106 % del visor: el recorrido justo para el giro, sin ampliarlas de más.
// `sizes` declara ese 106 % real para que el navegador elija la candidata a la resolución del móvil
// (antes declaraba 60vw y el navegador servía una foto corta, que es lo que se veía blando).
// Calidad 42: el velo las deja a media luz, así que a esa resolución no se distingue de 62
// y la candidata de 1600 px baja de 340 kB a 155 kB, dentro del presupuesto del hero (§4).
const sizes = '106vw';
const foto = async (img: ImageMetadata, format: 'avif' | 'webp') =>
  getImage({ src: img, format, widths: [640, 900, 1200, 1600], width: 1600, quality: 42 });
const izqAvif = await foto(izquierda, 'avif');
const izqWebp = await foto(izquierda, 'webp');
const derAvif = await foto(derecha, 'avif');
const derWebp = await foto(derecha, 'webp');

const whatsapp = enlaceWhatsapp(ficha, `Hola, quiero información sobre ${ficha.marca}.`);
---

<header class="relative flex min-h-dvh flex-col overflow-hidden text-hueso" data-hero data-sala="noche">
  <!-- La recepción, de izquierda a derecha, de fondo. La primera foto se ve desde el primer frame: es el LCP. -->
  <div class="absolute inset-0">
    <picture class="paneo-a absolute inset-0 block" data-foto-a>
      <source type="image/avif" srcset={izqAvif.srcSet.attribute} sizes={sizes} />
      <source type="image/webp" srcset={izqWebp.srcSet.attribute} sizes={sizes} />
      <img
        src={izqWebp.src}
        width={izquierda.width}
        height={izquierda.height}
        alt="Pared de listones de madera con espejos redondos, lámparas y césped con kettlebells en la entrada de Hevy Fit"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="block h-full w-[106%] max-w-none object-cover object-[center_45%]"
      />
    </picture>
    <picture class="paneo-b absolute inset-0 block" data-foto-b>
      <source type="image/avif" srcset={derAvif.srcSet.attribute} sizes={sizes} />
      <source type="image/webp" srcset={derWebp.srcSet.attribute} sizes={sizes} />
      <img
        src={derWebp.src}
        width={derecha.width}
        height={derecha.height}
        alt="Mostrador de recepción de Hevy Fit con el logo en neón magenta y blanco sobre la pared negra"
        loading="eager"
        fetchpriority="low"
        decoding="async"
        class="block h-full w-[106%] max-w-none object-cover object-[center_35%]"
      />
    </picture>
    <!-- Velo: deja ver la recepción arriba y se cierra en negro donde va el texto. -->
    <div class="velo absolute inset-0" aria-hidden="true"></div>
  </div>

  <div class="relative"><Cabecera ficha={ficha} /></div>

  <div class="relative mx-auto mt-auto w-full max-w-6xl px-4 pb-10 pt-24 sm:px-8 md:pb-14">
    {
      NOVEDAD && (
        <a
          href="#novedad"
          class="novedad mb-6 inline-flex min-h-11 items-center gap-2.5 rounded-full border-2 border-ambar bg-noche/70 px-4 font-bold text-hueso transition-colors hover:bg-ambar hover:text-noche"
        >
          <span class="punto-novedad inline-block size-2.5 rounded-full bg-ambar" aria-hidden="true" />
          {NOVEDAD.etiqueta}: {NOVEDAD.titulo}, 30 minutos
        </a>
      )
    }
    <h1 class="rotulo m-0 max-w-[16ch] text-[2.5rem] sm:text-6xl lg:text-[4.25rem]">Fuerza, Barre y Pilates en Bullas.</h1>
    <div class="mt-6 grid gap-6 md:grid-cols-[1fr_auto] md:items-end lg:mt-8">
      <p class="m-0 max-w-[48ch] text-lg leading-snug sm:text-xl" data-entra>
        Más de 500 m² de instalaciones y cuatro espacios diferentes, cada uno con su propia luz: entrenamientos
        en grupo, estudio de Barre y estudio de Pilates. En la avenida Luis de los Reyes, bajos 6, 11 y 40.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap" data-entra>
        <a
          href={ficha.web_reservas}
          class="inline-flex min-h-13 items-center justify-center rounded-full bg-neon px-7 text-lg font-bold text-noche transition-colors hover:bg-hueso"
          target="_blank"
          rel="noopener"
        >
          Inscribirme
        </a>
        <a
          href={whatsapp}
          class="inline-flex min-h-13 items-center justify-center gap-2.5 rounded-full border-2 border-hueso/40 px-6 text-lg font-bold text-hueso transition-colors hover:border-hueso"
          target="_blank"
          rel="noopener"
        >
          <Icono nombre="whatsapp" class="size-6" />
          Escribir por WhatsApp
        </a>
      </div>
    </div>
    <p class="mt-5 max-w-[60ch] text-hueso-tenue" data-entra>
      Matrícula única de 10 €, válida para todas las actividades.
    </p>
  </div>

  <div class="led luz-magenta relative origin-left" aria-hidden="true" data-led></div>
</header>

<style>
  /* Aviso de novedad: parpadea para llamar la atención (un halo que se expande y el punto que se
     enciende y apaga). Solo transform y opacity; con movimiento reducido queda quieto. */
  .novedad { position: relative; }
  .novedad::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: inherit;
    border: 2px solid var(--color-ambar);
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .novedad::after { animation: halo-novedad 1.6s ease-out infinite; }
    .punto-novedad { animation: parpadeo-novedad 0.8s steps(1, end) infinite; }
  }
  @keyframes halo-novedad {
    0% { opacity: 0.9; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.12, 1.5); }
  }
  @keyframes parpadeo-novedad {
    50% { opacity: 0.15; }
  }
  /* Estado inicial: se ve la primera foto (izquierda) y la segunda espera oculta.
     Con movimiento reducido no hay paneo y se muestra directamente el neón. */
  .paneo-a { will-change: transform; }
  .paneo-b { opacity: 0; will-change: transform, opacity; }
  @media (prefers-reduced-motion: reduce) {
    .paneo-b { opacity: 1; }
  }

  /* El velo deja la recepción a media luz arriba y se cierra en negro bajo el titular,
     para que el texto pase de sobra el contraste sea cual sea el fotograma que quede detrás. */
  .velo {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-noche) 90%, transparent) 0%,
      color-mix(in srgb, var(--color-noche) 48%, transparent) 22%,
      color-mix(in srgb, var(--color-noche) 66%, transparent) 46%,
      color-mix(in srgb, var(--color-noche) 94%, transparent) 72%,
      var(--color-noche) 94%
    );
  }
</style>

<script>
  import gsap from 'gsap';

  // Un solo momento orquestado (§5): giro de la recepción de izquierda a derecha con disolvencia
  // entre las dos fotos, y la tira LED que se enciende. Nada parte de opacity 0 salvo la segunda foto,
  // que no es el LCP. El titular no se toca; el resto solo se desplaza.
  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const a = hero?.querySelector<HTMLElement>('[data-foto-a]');
    const b = hero?.querySelector<HTMLElement>('[data-foto-b]');
    if (!hero || !a || !b) return;
    const led = hero.querySelector<HTMLElement>('[data-led]');
    const entran = hero.querySelectorAll<HTMLElement>('[data-entra]');

    const tl = gsap.timeline({ defaults: { ease: 'power1.inOut' } });
    // La cámara gira hacia la derecha: las dos fotos se desplazan a la izquierda a la misma velocidad.
    tl.fromTo(a, { xPercent: 0 }, { xPercent: -6, duration: 4.5 }, 0)
      .fromTo(b, { xPercent: -1 }, { xPercent: -5, duration: 4.5 }, 0)
      .to(b, { opacity: 1, duration: 1.4, ease: 'power2.inOut' }, 1.8)
      .from(entran, { y: 14, duration: 0.7, stagger: 0.08, ease: 'power3.out' }, 0)
      .from(led, { scaleX: 0, duration: 1.2 }, 0.3);
  });
</script>
