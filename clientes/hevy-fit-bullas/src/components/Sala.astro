---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { enlaceWhatsapp } from '@plantilla/lib/ficha';
import type { Actividad, FichaHevy, HorarioActividad } from '../lib/datos';
import type { Clip } from '../lib/fotos';
import Icono from './Icono.astro';
import RejillaHorario from './RejillaHorario.astro';

/**
 * Una sala del recorrido: su luz, sus fotos, sus tarifas y su horario.
 * Al entrar en la sección, el fondo de la página se tiñe con su luz (CambioSala.astro).
 */
interface Foto { src: ImageMetadata; alt: string }
interface Props {
  ficha: FichaHevy;
  actividad: Actividad;
  fotos: Foto[];
  horario?: HorarioActividad;
  /** Enlace a la página propia de la sala (portada). En la página de la sala no se muestra. */
  enlace?: string;
  /** Recorrido: vídeo que avanza con el scroll en un tramo fijo al principio de la sala. */
  recorrido?: Clip[];
}
const { ficha, actividad: a, fotos, horario, enlace, recorrido } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const whatsapp = enlaceWhatsapp(ficha, `Hola, quiero información sobre ${a.nombre} en Hevy Fit.`);
// Barre: fotos con arco, como los arcos de luz del estudio. Pilates: marco de listones de madera.
const marco = a.id === 'barre' ? 'arco' : 'rounded-xl';
const tarjeta = a.id === 'pilates' ? 'listones' : '';
---

<section id={a.id} data-sala={a.id} aria-labelledby={`${a.id}-titulo`} class:list={[`luz-${a.luz} px-4 py-16 sm:px-8 md:py-24`, recorrido && 'pt-0 md:pt-0']}>
  <!-- Recorrido: el marco se queda fijo una pantalla y el vídeo avanza con el scroll (GSAP ScrollTrigger).
       Con dos clips, el segundo se funde en el último tramo: la luz se enciende. Sin JS o con movimiento
       reducido queda el fotograma de portada y la página sigue con normalidad. -->
  {
    recorrido && (
      <div class="relative mb-6 h-[320dvh]" data-recorrido>
        <div class="sticky top-0 mx-auto flex h-dvh max-w-6xl items-center justify-center gap-10 px-4 sm:px-8 lg:justify-between">
          <div class="hidden lg:block lg:w-2/5" aria-hidden="true">
            <div class="led w-16"></div>
            <p class="rotulo m-0 mt-5 text-5xl">{a.nombre}</p>
            <p class="mt-5 max-w-[30ch] text-lg leading-snug text-hueso-tenue">Baja despacio: recorres la sala a tu ritmo.</p>
          </div>
          <div class:list={['relative h-[80dvh] w-full max-w-[min(92vw,calc(80dvh*0.75))] overflow-hidden bg-(--fondo-alto)', marco]} data-visor>
            {recorrido.map((v, i) => (
              <video
                class="absolute inset-0 h-full w-full object-cover"
                style={i > 0 ? 'opacity:0' : undefined}
                data-encendida={i > 0 ? '' : undefined}
                data-src={`${base}/${v.mp4}`}
                data-src-movil={`${base}/${v.mp4Movil}`}
                poster={`${base}/${v.poster}`}
                aria-label={v.alt}
                muted
                playsinline
                preload="none"
              />
            ))}
            <p class="pointer-events-none absolute bottom-3 left-3 m-0 rounded-full bg-noche/80 px-3 py-1 text-sm font-bold text-hueso lg:hidden">{a.nombre}</p>
            <p class="pointer-events-none absolute bottom-3 right-3 m-0 rounded-full bg-noche/80 px-3 py-1 text-sm text-hueso-tenue" data-pista>Baja para recorrer la sala</p>
          </div>
        </div>
      </div>
    )
  }
  <div class="mx-auto max-w-6xl">
    <div class="reveal max-w-[44rem]">
      <div class="led w-16" aria-hidden="true"></div>
      <h2 id={`${a.id}-titulo`} class="rotulo m-0 mt-5 text-3xl sm:text-5xl">{a.nombre}</h2>
      <p class="mt-5 max-w-[52ch] text-lg leading-snug text-hueso-tenue">
        {a.texto} <span class="texto-luz font-bold">{a.sala}.</span>
      </p>
      {enlace && (
        <p class="mt-4">
          <a href={enlace} class="texto-luz inline-flex min-h-11 items-center border-b-2 border-current font-bold hover:text-hueso">
            Ver la sala: fotos, tarifas y horario
          </a>
        </p>
      )}
    </div>

    <div class="mt-10 grid gap-5 md:mt-12 lg:grid-cols-[3fr_2fr] lg:gap-8">
      <!-- Dos marcos; en cada uno las fotos de la sala van pasando con un fundido (pase de fotos, §5: solo opacity). -->
      <ul class="reveal m-0 grid list-none grid-cols-2 gap-3 self-start p-0 md:gap-4" data-pase>
        {
          [0, 1].map((marcoIdx) => {
            // El marco izquierdo lleva el vídeo (si lo hay) y tres fotos; el derecho, seis fotos.
            const pila = fotos.filter((_, i) => i % 2 === marcoIdx).slice(0, 6);
            const conVideo = false;
            return (
              <li class:list={['foto-zoom relative aspect-[3/4] overflow-hidden', marco]} data-marco>
                {pila.map((f, i) => (
                  <Picture
                    src={f.src}
                    alt={f.alt}
                    formats={['avif', 'webp']}
                    widths={[360, 540, 760, 1000]}
                    sizes="(min-width: 1024px) 30vw, 50vw"
                    loading="lazy"
                    decoding="async"
                    pictureAttributes={{ class: 'diapo absolute inset-0 block h-full', 'data-activa': i === 0 && !conVideo ? '' : undefined }}
                    class="block h-full w-full object-cover"
                  />
                ))}
              </li>
            );
          })
        }
      </ul>

      <div class:list={["reveal-tarde flex flex-col rounded-2xl border border-(--borde) bg-(--fondo-alto) p-6 sm:p-8", tarjeta]}>
        <h3 class="m-0 text-xl font-bold">Tarifas</h3>
        <dl class="mt-4 divide-y divide-(--borde) border-t border-(--borde)">
          {
            a.tarifas.map((t) => (
              <div class="flex items-baseline justify-between gap-4 py-3">
                <dt class="leading-snug">
                  {t.nombre}
                  {t.nota && <small class="block text-sm text-hueso-tenue">{t.nota}</small>}
                </dt>
                <dd class="texto-luz m-0 whitespace-nowrap text-right text-lg font-bold tabular-nums">{t.precio}</dd>
              </div>
            ))
          }
        </dl>
        <div class="mt-6 flex flex-col gap-3">
          <a
            href={ficha.web_reservas}
            class="inline-flex min-h-12 items-center justify-center rounded-full bg-neon px-6 font-bold text-noche transition-colors hover:bg-hueso"
            target="_blank"
            rel="noopener"
          >
            Reservar
          </a>
          <a
            href={whatsapp}
            class="inline-flex min-h-12 items-center justify-center gap-2.5 rounded-full border-2 border-(--borde) px-6 font-bold text-hueso transition-colors hover:border-hueso"
            target="_blank"
            rel="noopener"
          >
            <Icono nombre="whatsapp" class="size-5" />
            Preguntar por WhatsApp
          </a>
        </div>
      </div>
    </div>

    {
      horario && (
        <div class="reveal mt-12 md:mt-16" data-horario>
          <h3 class="m-0 text-xl font-bold">Horario semanal de {a.nombre}</h3>
          <div class="mt-5">
            <RejillaHorario ficha={ficha} horario={horario} />
          </div>
        </div>
      )
    }
  </div>
</section>

<script>
  // Pase de fotos de cada marco, con fundido y los dos marcos desfasados. Solo corre con la sección
  // en pantalla y nunca con movimiento reducido.
  const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const movil = window.matchMedia('(max-width: 767px)').matches;
  const fuente = (v: HTMLVideoElement) => (movil ? v.dataset.srcMovil : v.dataset.src) ?? '';

  if (!sinMovimiento) {
    document.querySelectorAll<HTMLElement>('[data-pase]').forEach((pase) => {
      const marcos = [...pase.querySelectorAll<HTMLElement>('[data-marco]')];
      const vids = [...pase.querySelectorAll<HTMLVideoElement>('video')];
      let cargado = false;
      const cargar = () => {
        if (cargado) return;
        cargado = true;
        vids.forEach((v) => { v.src = fuente(v); v.load(); });
      };
      let temporizadores: number[] = [];
      const arrancar = () => {
        cargar();
        marcos.forEach((marco, m) => {
          const diapos = [...marco.querySelectorAll<HTMLElement>('.diapo')];
          if (diapos.length < 2) return;
          let i = Math.max(0, diapos.findIndex((d) => d.hasAttribute('data-activa')));
          const mostrar = () => {
            diapos.forEach((d) => {
              d.removeAttribute('data-activa');
              if (d instanceof HTMLVideoElement) d.pause();
            });
            const d = diapos[i];
            d.setAttribute('data-activa', '');
            let dura = 4800;
            if (d instanceof HTMLVideoElement) {
              d.currentTime = 0;
              d.play().catch(() => {});
              dura = Number(d.dataset.segundos ?? 8) * 1000;
            }
            temporizadores.push(window.setTimeout(() => { i = (i + 1) % diapos.length; mostrar(); }, dura));
          };
          temporizadores.push(window.setTimeout(mostrar, m * 2400));
        });
      };
      const parar = () => {
        temporizadores.forEach((t) => window.clearTimeout(t));
        temporizadores = [];
        vids.forEach((v) => v.pause());
      };
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([e]) => (e.isIntersecting ? arrancar() : parar()), { threshold: 0.2, rootMargin: '200px 0px' }).observe(pase);
      } else {
        arrancar();
      }
    });

  }
</script>

<script>
  // Recorrido con el scroll: el visor va pegado (position: sticky) mientras la pista de 320dvh pasa por
  // debajo, y el tiempo del vídeo sigue al avance dentro de la pista. Se pide como mucho un salto de
  // fotograma por clip a la vez (si el decodificador va lento, se salta al último objetivo al terminar).
  // Con dos clips, el segundo (la luz encendida) aparece en el último tramo.
  const recorridos = document.querySelectorAll<HTMLElement>('[data-recorrido]');
  const sinMovimientoRec = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (recorridos.length && !sinMovimientoRec) {
    const movil = window.matchMedia('(max-width: 767px)').matches;
    const clamp = (x: number) => Math.min(1, Math.max(0, x));
    recorridos.forEach((tramo) => {
      const vids = [...tramo.querySelectorAll<HTMLVideoElement>('video')];
      const encendida = tramo.querySelector<HTMLVideoElement>('[data-encendida]');
      const pista = tramo.querySelector<HTMLElement>('[data-pista]');
      let cargado = false;
      const cargar = () => {
        if (cargado) return;
        cargado = true;
        vids.forEach((v) => {
          v.src = (movil ? v.dataset.srcMovil : v.dataset.src) ?? '';
          v.preload = 'auto';
          v.load();
        });
      };
      // Los clips se cargan cuando la sala está a pantalla y media.
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { cargar(); io.disconnect(); } }, { rootMargin: '150% 0px' });
        io.observe(tramo);
      } else {
        cargar();
      }

      let objetivo = 0;
      let pendiente = false;
      const progreso = () => {
        const r = tramo.getBoundingClientRect();
        return clamp(-r.top / Math.max(1, tramo.offsetHeight - window.innerHeight));
      };
      const pintar = () => {
        pendiente = false;
        vids.forEach((v) => {
          if (!v.duration || v.seeking) return;
          const t = objetivo * Math.max(0, v.duration - 0.08);
          if (Math.abs(v.currentTime - t) > 0.03) v.currentTime = t;
        });
        if (encendida) encendida.style.opacity = String(clamp((objetivo - 0.82) / 0.14));
        if (pista) pista.style.opacity = objetivo > 0.05 ? '0' : '1';
      };
      const programar = () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(pintar);
      };
      const alScroll = () => { objetivo = progreso(); programar(); };
      vids.forEach((v) => v.addEventListener('seeked', programar));
      window.addEventListener('scroll', alScroll, { passive: true });
      window.addEventListener('resize', alScroll, { passive: true });
      alScroll();
    });
  }
</script>
