---
import { enlaceComoLlegar } from '@plantilla/lib/ficha';
import type { Ficha } from '@plantilla/lib/ficha';
import Icono from './Icono.astro';
import plano from './plano.json';

/**
 * Dónde está. El plano es propio: las calles reales de Caravaca sacadas de OpenStreetMap
 * (mapa/plano.mjs), claras sobre el vinilo, con la avenida Juan Carlos I en azul noche, la
 * peluquería marcada con su rótulo en pequeño y el Santuario de la Vera Cruz de referencia, que es
 * por donde se orienta cualquiera en Caravaca. No carga nada de fuera ni pone cookies.
 * «Cómo llegar» abre la ruta en Google Maps hasta su ficha (en el móvil, en la app).
 */
interface Props { ficha: Ficha & { place_id?: string } }
const { ficha } = Astro.props;
const comoLlegar = ficha.place_id
  ? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(ficha.nombre)}&destination_place_id=${ficha.place_id}`
  : enlaceComoLlegar(ficha);

// Recorte del plano: todo el ancho y la franja que va de la peluquería al santuario.
const { lado, peluqueria, santuario, avenida, capas } = plano as {
  lado: number;
  peluqueria: [number, number];
  santuario: [number, number];
  avenida: { x: number; y: number; angulo: number } | null;
  capas: Record<string, string>;
};
const VISTA = { x: 0, y: 250, ancho: lado, alto: 900 };
const pct = ([x, y]: [number, number]) =>
  `left:${(((x - VISTA.x) / VISTA.ancho) * 100).toFixed(2)}%;top:${(((y - VISTA.y) / VISTA.alto) * 100).toFixed(2)}%`;
---

<section id="donde" class="panos donde" aria-labelledby="donde-titulo">
  <div class="pano w-texto">
    <h2 id="donde-titulo" class="titular h2-bloque">Dónde está</h2>
    <address class="w-direccion">
      <span class="w-calle">{ficha.direccion}</span>
      <span>{ficha.cp} {ficha.pueblo}</span>
    </address>
    <div class="w-botones">
      <a href={comoLlegar} class="w-boton boton" target="_blank" rel="noopener">
        <Icono nombre="ruta" class="size-5" />
        Cómo llegar
      </a>
      <a href={ficha.maps_url} class="w-ficha" target="_blank" rel="noopener">Su ficha en Google Maps</a>
    </div>
  </div>

  <figure class="pano-claro w-plano">
    <svg
      viewBox={`${VISTA.x} ${VISTA.y} ${VISTA.ancho} ${VISTA.alto}`}
      class="w-svg"
      role="img"
      aria-label="Plano de Caravaca con la peluquería en la avenida Juan Carlos I, al suroeste del Santuario de la Vera Cruz"
    >
      <g fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d={capas.rio} stroke="#c9d5df" stroke-width="16" />
        <path d={capas.menor} stroke="#fbfcfd" stroke-width="4" />
        <path d={capas.calle} stroke="#fbfcfd" stroke-width="6" />
        <path d={capas.media} stroke="#fbfcfd" stroke-width="9" />
        <path d={capas.principal} stroke="#fbfcfd" stroke-width="11" />
        <path d={capas.avenida} stroke="#1b2f44" stroke-width="11" />
      </g>
      <circle cx={santuario[0]} cy={santuario[1]} r="10" fill="#1b2f44" />
    </svg>
    <span class="w-etiqueta w-santuario" style={pct(santuario)} aria-hidden="true">Santuario de la Vera Cruz</span>
    {
      avenida && (
        <span class="w-etiqueta w-avenida" style={`${pct([avenida.x, avenida.y])};--giro:${avenida.angulo}deg`} aria-hidden="true">
          Av. Juan Carlos I
        </span>
      )
    }
    <!-- La peluquería: su rótulo en pequeño, con un punto donde está la puerta. -->
    <span class="w-marca" style={pct(peluqueria)} aria-hidden="true">
      <span class="w-rotulo">Víctor Manuel</span>
    </span>
    <figcaption class="w-credito">
      Plano: © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">colaboradores de OpenStreetMap</a>
    </figcaption>
  </figure>
</section>

<style>
  .w-texto { display: flex; flex-direction: column; gap: 1.1rem; }
  .w-direccion { font-style: normal; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.15rem; font-size: 1.1rem; line-height: 1.35; }
  /* Una calle con una palabra larguísima no puede ensanchar la rejilla (§13). */
  .w-direccion span { overflow-wrap: anywhere; }
  .w-calle { font-size: clamp(1.45rem, 2.2vw, 2rem); font-weight: 800; letter-spacing: -0.015em; line-height: 1.1; }
  .w-botones { margin-top: auto; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  .w-boton {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    gap: 0.55rem;
    padding-inline: 1.3rem;
    background: var(--color-azul);
    color: var(--color-luz);
    font-weight: 700;
    font-size: 1.08rem;
    text-decoration: none;
  }
  .w-boton:hover { background: var(--color-azul-hondo); }
  .w-ficha {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    font-weight: 700;
    color: var(--color-azul);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  /* El plano, detrás de un paño de cristal: el vinilo es el suelo, las calles en blanco. */
  .w-plano {
    margin: 0;
    grid-column: 1 / -1;
    aspect-ratio: 1400 / 900;
    background: #dfe6ec;
  }
  .w-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .w-etiqueta {
    position: absolute;
    z-index: 1;
    translate: -50% -50%;
    white-space: nowrap;
    font-size: clamp(0.7rem, 1.1vw, 0.9rem);
    font-weight: 700;
    color: var(--color-azul);
  }
  .w-santuario { translate: -88% -170%; }
  /* El nombre de la avenida: en el móvil, por debajo de la línea (por encima chocaba con el
     rótulo de la peluquería); en escritorio, por encima. */
  .w-avenida {
    rotate: var(--giro, 0deg);
    translate: -30% 45%;
    font-weight: 800;
  }
  @media (min-width: 900px) {
    .w-avenida { translate: -50% -140%; }
  }
  /* El rótulo en miniatura: caja azul con filete blanco y el nombre en su letra de pincel. */
  .w-marca {
    position: absolute;
    z-index: 1;
    width: 0.8rem;
    height: 0.8rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--color-azul);
    box-shadow: 0 0 0 3px #fff;
  }
  .w-rotulo {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.55rem);
    translate: -50% 0;
    padding: 0.15rem 0.7rem 0.3rem;
    white-space: nowrap;
    font-family: var(--font-rotulo);
    font-size: clamp(1.05rem, 1.7vw, 1.45rem);
    line-height: 1.1;
    color: #fff;
    background: var(--color-azul);
    outline: 1.5px solid #fff;
    outline-offset: -4px;
    box-shadow: 0 6px 18px -6px rgb(20 36 59 / 0.5);
  }
  .w-credito {
    position: absolute;
    z-index: 1;
    right: 0.5rem;
    bottom: 0.4rem;
    font-size: 0.72rem;
    color: var(--color-azul-tenue);
  }
  .w-credito a { color: inherit; }

  .w-texto { grid-column: 1 / -1; }
  @media (min-width: 900px) {
    .w-texto { grid-column: 1 / 3; }
    .w-plano { grid-column: 3 / 5; }
  }
</style>
