---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * El taller en fotos, a sangre y en blanco y negro. En escritorio, un mosaico de borde a borde:
 * la nave grande con el coche en el elevador y cuatro detalles; cada foto está detrás de la
 * persiana de la nave, que sube al entrar (.persiana-md, global.css). En el móvil, una tira que se
 * desliza con el dedo.
 * Son de Higgsfield mientras el taller no ceda las suyas (§6), y lo dice.
 */
interface Foto { src: ImageMetadata; alt: string }
interface Props { fotos: Foto[] }
const { fotos } = Astro.props;
// Tamaño de cada foto en el mosaico de escritorio (columnas de 12), por orden.
const MOSAICO = ['grande', 'alta', 'normal', 'normal', 'normal'];
---

<section id="taller" class="taller" aria-labelledby="taller-titulo">
  <div class="margen flex flex-wrap items-end justify-between gap-x-10 gap-y-3 pb-10 pt-[clamp(5rem,14svh,9rem)] md:pb-14">
    <h2 id="taller-titulo" class="ancha m-0 text-[clamp(2.1rem,4.4vw,4.4rem)]">La nave</h2>
    <p class="m-0 max-w-[40ch] text-niebla">Fotografías de muestra, hasta que el taller ceda las suyas.</p>
  </div>
  <ul class="taller-mosaico" tabindex="0" aria-label="Fotos del taller, desplazables">
    {
      fotos.map((f, i) => (
        <li class={`taller-foto taller-foto--${MOSAICO[i] ?? 'normal'} persiana-md`}>
          <Picture
            src={f.src}
            alt={f.alt}
            formats={['avif', 'webp']}
            widths={MOSAICO[i] === 'grande' ? [540, 960, 1376] : [360, 540, 760]}
            sizes={MOSAICO[i] === 'grande' ? '(min-width: 900px) 67vw, 82vw' : '(min-width: 900px) 34vw, 82vw'}
            quality={55}
            loading="lazy"
            decoding="async"
            pictureAttributes={{ class: 'block h-full' }}
            class="block h-full w-full object-cover"
          />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .taller { background: var(--color-negro); padding-bottom: clamp(5rem, 14svh, 9rem); }

  /* Móvil: tira deslizable con ajuste al soltar. */
  .taller-mosaico {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 82vw;
    gap: 0.5rem;
    margin: 0;
    padding: 0 clamp(1.25rem, 5vw, 6rem);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: clamp(1.25rem, 5vw, 6rem);
    scrollbar-width: none;
  }
  .taller-mosaico::-webkit-scrollbar { display: none; }
  .taller-foto { aspect-ratio: 4 / 5; overflow: hidden; scroll-snap-align: start; background: #0c0c0c; }
  .taller-foto--grande { grid-column: span 1; }

  /* Escritorio: mosaico de borde a borde en 12 columnas. Arriba la nave (8) y una vertical (4);
     abajo tres detalles (4 + 4 + 4). */
  @media (min-width: 900px) {
    .taller-mosaico {
      grid-auto-flow: row;
      grid-template-columns: repeat(12, 1fr);
      grid-auto-columns: auto;
      gap: 0.375rem;
      padding: 0;
      overflow: visible;
    }
    .taller-foto { aspect-ratio: auto; grid-column: span 4; height: min(38vw, 88svh); }
    .taller-foto--grande { grid-column: span 8; height: auto; aspect-ratio: 16 / 9; }
    .taller-foto--alta { grid-column: span 4; height: auto; position: relative; }
    .taller-foto--alta :global(picture) { position: absolute; inset: 0; }
  }

</style>
