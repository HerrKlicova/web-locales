---
import '../styles/global.css';
// Una sola familia, Mona Sans (OFL), en tres cortes estáticos recortados al español y renombrados
// «SC Grotesk» (src/fuentes/instancias.py): la ancha para titulares y cifras, la normal para el
// texto. @font-face a mano, con font-display: swap y solo lo que se usa (§8).
import ancha700 from '../fuentes/sc-grotesk-ancha-700.woff2?url';
import texto400 from '../fuentes/sc-grotesk-texto-400.woff2?url';
import texto600 from '../fuentes/sc-grotesk-texto-600.woff2?url';

interface Props {
  titulo: string;
  descripcion: string;
  /** Demo: noindex, sin sitemap, sin formulario (§11). */
  demo?: boolean;
  schema?: Record<string, unknown>;
  /** Imagen del LCP: se precarga para que el navegador no espere a parsear el cuerpo (§8). */
  precarga?: { srcset: string; sizes: string; tipo: string; media?: string }[];
}
const { titulo, descripcion, demo = true, schema, precarga = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fuentes = [
  { url: ancha700, familia: 'SC Grotesk Ancha', peso: 700 },
  { url: texto400, familia: 'SC Grotesk', peso: 400 },
  { url: texto600, familia: 'SC Grotesk', peso: 600 },
];
// La tarjeta al compartir el enlace (WhatsApp, sobre todo: la demo se enseña por ahí). WhatsApp
// solo acepta la imagen con dirección completa: en producción sale del dominio del cliente y en
// demo, del Worker de demos (scripts/demo.mjs).
const ORIGEN_DEMO = 'https://webs-locales-demo.webs-locales.workers.dev';
const imagenSocial = Astro.site ? new URL('og.jpg', Astro.site).href : `${ORIGEN_DEMO}${base}/og.jpg`;
const canonica = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {demo && <meta name="robots" content="noindex, nofollow" />}
    {canonica && <link rel="canonical" href={canonica} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sánchez Carreño" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es_ES" />
    {canonica && <meta property="og:url" content={canonica} />}
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logotipo de Sánchez Carreño junto a un coche con el capó abierto en la nave del taller" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="preload" as="font" type="font/woff2" href={ancha700} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={texto400} crossorigin />
    {
      precarga.map((p) => (
        <link
          rel="preload"
          as="image"
          type={p.tipo}
          imagesrcset={p.srcset}
          imagesizes={p.sizes}
          media={p.media}
          fetchpriority="high"
        />
      ))
    }
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <style
      is:global
      set:html={fuentes
        .map(
          (f) =>
            `@font-face{font-family:"${f.familia}";font-style:normal;font-weight:${f.peso};font-display:swap;src:url(${f.url}) format("woff2");}`,
        )
        .join('')}
    />
  </head>
  <body class="min-h-dvh">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-full focus:bg-blanco focus:px-5 focus:py-2.5 focus:font-semibold focus:text-negro"
      >Ir al contenido</a
    >
    <slot />
  </body>
</html>
