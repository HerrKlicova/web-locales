---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { esHueco } from '@plantilla/lib/ficha';
import type { Ficha } from '@plantilla/lib/ficha';

/**
 * Lo que hace, con su precio, como una lista de precios de peluquería: el nombre y, a la derecha,
 * tras los puntos, el precio. Mientras no haya precios, el hueco [PRECIO] va en su sitio, en gris:
 * se lee como sitio reservado, no como un fallo ni como un botón.
 * Escritorio: título en un paño alto a la izquierda, los cuatro servicios en el centro y la foto de
 * la tijera y el peine detrás de dos paños de cristal a la derecha.
 * Móvil: título y foto arriba, y los servicios de dos en dos.
 */
interface Props { ficha: Ficha; foto: ImageMetadata }
const { ficha, foto } = Astro.props;

// Una línea por servicio, con palabras de sus reseñas (investigacion.md). Nada que no conste.
const lineas: Record<string, string> = {
  'Corte a tijera': 'El corte de toda la vida.',
  Degradado: 'Para quien lo quiere corto por los lados.',
  'Arreglo de barba': 'Recortada y perfilada.',
  'Corte infantil': 'Con paciencia, y el corte que el crío pide.',
};
---

<section id="servicios" class="panos servicios" aria-labelledby="servicios-titulo">
  <div class="pano s-titulo">
    <h2 id="servicios-titulo" class="titular h2-bloque">Qué hacemos</h2>
  </div>

  {
    ficha.servicios.map((s, i) => (
      <div class={`pano s-item s-item-${i + 1}`}>
        <h3 class="titular s-nombre">{s.nombre}</h3>
        {lineas[s.nombre] && <p class="s-linea">{lineas[s.nombre]}</p>}
        <p class="s-precio">
          <span class="s-puntos" aria-hidden="true" />
          {esHueco(s.precio) ? <span class="s-hueco">[PRECIO]</span> : <span class="tabular-nums">{s.precio}</span>}
        </p>
      </div>
    ))
  }

  <div class="pano-claro s-foto">
    <Picture
      src={foto}
      formats={['avif', 'webp']}
      widths={[400, 640, 900]}
      sizes="(min-width: 900px) 25vw, 50vw"
      alt="Una tijera de peluquero y un peine negro sobre el mostrador blanco, con pelo recién cortado al lado"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="vidrio s-v1" aria-hidden="true"></div>
  <div class="vidrio s-v2" aria-hidden="true"></div>
</section>

<style>
  .s-titulo { display: flex; flex-direction: column; justify-content: flex-start; }
  .s-item { display: flex; flex-direction: column; gap: 0.5rem; }
  .s-nombre { margin: 0; font-size: clamp(1.2rem, 1.7vw, 1.65rem); }
  .s-linea { margin: 0; font-size: 1.05rem; line-height: 1.4; color: var(--color-azul-tenue); }
  /* El precio, tras los puntos guía de una lista de precios. */
  .s-precio {
    margin: 0;
    margin-top: auto;
    padding-top: 1rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 1.3rem;
    font-weight: 800;
  }
  .s-puntos { flex: 1; min-width: 1.5rem; border-bottom: 2px dotted rgb(27 47 68 / 0.35); transform: translateY(-0.25em); }
  .s-hueco { font-size: 0.95rem; font-weight: 700; letter-spacing: 0.02em; color: var(--color-azul-tenue); white-space: nowrap; }

  /* Móvil: título | foto; servicios de dos en dos. */
  .s-titulo { grid-area: 1 / 1; }
  .s-foto { grid-area: 1 / 2; min-height: 12rem; }
  .s-v1, .s-v2 { display: none; }

  @media (min-width: 900px) {
    .s-titulo { grid-area: 1 / 1 / 3 / 2; }
    .s-item-1 { grid-area: 1 / 2; }
    .s-item-2 { grid-area: 1 / 3; }
    .s-item-3 { grid-area: 2 / 2; }
    .s-item-4 { grid-area: 2 / 3; }
    .s-foto { grid-area: 1 / 4 / 3 / 5; min-height: 26rem; }
    .s-v1 { display: block; grid-area: 1 / 4; }
    .s-v2 { display: block; grid-area: 2 / 4; }
  }
</style>
