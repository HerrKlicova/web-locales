---
import { enlaceWhatsapp } from '@plantilla/lib/ficha';
import { DIAS, LEYENDA, type Celda, type FichaHevy, type HorarioActividad } from '../lib/datos';

/**
 * Horario semanal de una actividad: rejilla de horas por días en escritorio, lista por día en móvil.
 * Cada clase lleva un punto: verde si el grupo está en marcha, rojo si está parado y se abre
 * cuando hay gente interesada. Cada clase es un enlace a WhatsApp con el mensaje ya escrito.
 */
interface Props { ficha: FichaHevy; horario: HorarioActividad; duracion?: number }
const { ficha, horario: h, duracion = 50 } = Astro.props;

const fin = (hora: string) => {
  const [hh, mm] = hora.split(':').map(Number);
  const total = hh * 60 + mm + duracion;
  return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
};
const activo = (c: NonNullable<Celda>) => c.estado !== 'inactivo';
const enlace = (c: NonNullable<Celda>, dia: string, hora: string) =>
  enlaceWhatsapp(
    ficha,
    activo(c)
      ? `Hola, me interesa ${h.nombre} el ${dia.toLowerCase()} a las ${hora}. ¿Queda plaza?`
      : `Hola, me interesa ${h.nombre} el ${dia.toLowerCase()} a las ${hora}. Ese grupo no está activo, ¿podríais abrirlo?`,
  );
/* El contexto va como texto solo para lectores, detrás de la hora, y no como aria-label:
   así el nombre accesible del enlace contiene su texto visible (WCAG 2.5.3, «Label in Name»). */
const contexto = (c: NonNullable<Celda>, dia: string) =>
  `${h.nombre}, ${dia.toLowerCase()}. ${activo(c) ? 'Grupo activo' : 'Grupo inactivo, se abre si hay interés'}. Preguntar por WhatsApp`;
const clase = (c: NonNullable<Celda>) =>
  activo(c) ? 'bg-(--luz)/25 hover:bg-(--luz)/40' : 'border border-(--borde) bg-(--fondo-alto) hover:border-hueso-tenue';
const punto = (c: NonNullable<Celda>) => (activo(c) ? 'bg-activo' : 'bg-inactivo');
---

<div class={`luz-${h.luz}`}>
  <!-- Escritorio: rejilla de semana. Las filas son horas y las columnas, días. -->
  <table class="hidden w-full border-separate border-spacing-1 md:table">
    <caption class="sr-only">Horario semanal de {h.nombre}</caption>
    <thead>
      <tr>
        <th scope="col" class="w-16 pb-2 text-left font-bold text-hueso-tenue">Hora</th>
        {DIAS.map((d) => <th scope="col" class="pb-2 pl-3 text-left font-bold text-hueso-tenue">{d}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        h.filas.map((f) => (
          <tr>
            <th scope="row" class="py-1 pr-3 text-left font-bold tabular-nums text-hueso-tenue">{f.hora}</th>
            {f.dias.map((c, di) => (
              <td class="p-0 align-top">
                {c && (
                  <a
                    href={enlace(c, DIAS[di], f.hora)}
                    class:list={['flex min-h-14 flex-col justify-center rounded-md px-3 py-1.5 leading-tight text-hueso transition-colors', clase(c)]}
                    target="_blank"
                    rel="noopener"
                  >
                    <span class="flex items-center gap-2 font-bold tabular-nums">
                      <span class:list={['size-2 shrink-0 rounded-full', punto(c)]} aria-hidden="true" />
                      {f.hora}
                      <span class="font-normal text-hueso-tenue">– {fin(f.hora)}</span>
                    </span>
                    {c.nota && <span class:list={['pl-4 text-sm', activo(c) ? 'texto-luz' : 'text-hueso-tenue']}>{c.nota}</span>}
                    <span class="sr-only">{contexto(c, DIAS[di])}</span>
                  </a>
                )}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>

  <!-- Móvil: lista por día -->
  <dl class="m-0 grid gap-4 md:hidden">
    {
      DIAS.map((d, di) => {
        const clases = h.filas.flatMap((f) => (f.dias[di] ? [{ hora: f.hora, c: f.dias[di]! }] : []));
        return (
          <div class="border-t border-(--borde) pt-3">
            <dt class="font-bold">{d}</dt>
            <dd class="m-0 mt-2 flex flex-wrap gap-2">
              {clases.length === 0 && <span class="text-hueso-tenue">Sin clases</span>}
              {clases.map(({ hora, c }) => (
                <a
                  href={enlace(c, d, hora)}
                  class:list={['flex min-h-11 flex-col justify-center rounded-md px-3 py-1 leading-tight text-hueso', clase(c)]}
                  target="_blank"
                  rel="noopener"
                >
                  <span class="flex items-center gap-2 font-bold tabular-nums">
                    <span class:list={['size-2 shrink-0 rounded-full', punto(c)]} aria-hidden="true" />
                    {hora}
                    <span class="font-normal text-hueso-tenue">– {fin(hora)}</span>
                  </span>
                  {c.nota && <span class:list={['pl-4 text-sm', activo(c) ? 'texto-luz' : 'text-hueso-tenue']}>{c.nota}</span>}
                  <span class="sr-only">{contexto(c, d)}</span>
                </a>
              ))}
            </dd>
          </div>
        );
      })
    }
  </dl>

  <div class="mt-5 flex flex-col gap-2 text-sm text-hueso-tenue sm:flex-row sm:flex-wrap sm:gap-x-8">
    <ul class="m-0 flex list-none flex-wrap gap-x-6 gap-y-1 p-0">
      <li class="inline-flex items-center gap-2">
        <span class="inline-block size-2.5 rounded-full bg-activo" aria-hidden="true" />
        {LEYENDA.activo}
      </li>
      <li class="inline-flex items-center gap-2">
        <span class="inline-block size-2.5 rounded-full bg-inactivo" aria-hidden="true" />
        {LEYENDA.inactivo}
      </li>
    </ul>
    <p class="m-0">Pulsa una clase para escribirnos por WhatsApp.</p>
    {h.aviso && <p class="m-0">{h.aviso}</p>}
  </div>
</div>
