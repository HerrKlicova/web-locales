---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Ficha, Resena } from '@plantilla/lib/ficha';
import Icono from './Icono.astro';

/**
 * Las siete reseñas de su ficha de Google, copiadas tal cual, con sus faltas y con el nombre de
 * quien la escribió (§10). Cada una en su paño; la larga de Virginia ocupa dos. La foto de las
 * manos cortando va en el paño alto de la derecha, entera: un perfil por en medio caía justo sobre
 * el peine.
 */
interface Props { ficha: Ficha; valoracion: number; numResenas: number; foto: ImageMetadata }
const { ficha, valoracion, numResenas, foto } = Astro.props;
const nota = valoracion.toLocaleString('es-ES', { minimumFractionDigits: 1 });

// Dónde va cada reseña en la rejilla (por autor, para no depender del orden de la ficha).
const sitio: Record<string, string> = {
  Juan: 'o-juan',
  'Cristobal Gimenez': 'o-cristobal',
  'Sergio Martínez Suárez': 'o-sergio',
  'J RA': 'o-jra',
  'Virginia A.G.': 'o-virginia',
  'Sandra Gonzalez': 'o-sandra',
  pedroalarcon25: 'o-pedro',
};
// Orden de lectura (el del móvil); en escritorio cada una va a su paño con grid-area.
const orden = ['Juan', 'J RA', 'Virginia A.G.', 'Sergio Martínez Suárez', 'Cristobal Gimenez', 'Sandra Gonzalez', 'pedroalarcon25'];
const resenas = orden
  .map((autor) => ficha.resenas.find((r: Resena) => r.autor === autor))
  .filter((r): r is Resena => !!r);
---

<section id="opiniones" class="panos opiniones" aria-labelledby="opiniones-titulo">
  <div class="pano o-titulo">
    <h2 id="opiniones-titulo" class="titular h2-bloque">Lo que dicen en Google</h2>
    <p class="o-nota">
      <span class="o-cifra tabular-nums">{nota}</span>
      <span class="o-estrellas" role="img" aria-label={`${nota} de 5 estrellas`}>
        {Array.from({ length: 5 }).map(() => <Icono nombre="estrella" class="size-5" />)}
      </span>
      <span class="o-cuantas">con {numResenas} reseñas</span>
    </p>
    <a href={ficha.maps_url} class="o-enlace boton" target="_blank" rel="noopener">
      <Icono nombre="google" class="size-5" />
      Leerlas todas en Google
    </a>
  </div>

  {
    resenas.map((r) => (
      <figure class={`pano o-resena ${sitio[r.autor]}`}>
        <blockquote class="o-texto">
          <p>«{r.texto}»</p>
        </blockquote>
        <figcaption class="o-autor">
          <span class="o-mini" role="img" aria-label={`${r.estrellas} de 5 estrellas`}>
            {Array.from({ length: r.estrellas }).map(() => <Icono nombre="estrella" class="size-3.5" />)}
          </span>
          {r.autor}
        </figcaption>
      </figure>
    ))
  }

  <div class="pano-claro o-foto">
    <Picture
      src={foto}
      formats={['avif', 'webp']}
      widths={[400, 640, 900]}
      sizes="(min-width: 900px) 25vw, 50vw"
      alt="Manos de peluquero cortando a tijera sobre peine en la nuca de un cliente"
      loading="lazy"
      decoding="async"
    />
  </div>

</section>

<style>
  .o-titulo { display: flex; flex-direction: column; gap: 1rem; }
  .o-nota { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.6rem; }
  .o-cifra { font-size: 2.6rem; font-weight: 800; line-height: 1; letter-spacing: -0.02em; }
  .o-estrellas { display: inline-flex; gap: 0.1rem; color: var(--color-azul); }
  .o-cuantas { flex-basis: 100%; font-size: 1rem; color: var(--color-azul-tenue); }
  .o-enlace {
    margin-top: auto;
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-weight: 700;
    color: var(--color-azul);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .o-enlace:hover { text-decoration-thickness: 3px; }

  .o-resena { margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .o-texto { margin: 0; }
  .o-texto p { margin: 0; font-size: 1.05rem; line-height: 1.45; }
  /* La corta de Juan va en grande: es la que resume la web. */
  .o-juan .o-texto p { font-size: clamp(1.35rem, 2vw, 1.85rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.015em; }
  .o-autor { margin-top: auto; display: flex; flex-direction: column; gap: 0.3rem; font-weight: 700; font-size: 0.95rem; }
  .o-mini { display: inline-flex; gap: 0.1rem; color: var(--color-azul); }
  .o-foto { min-height: 12rem; }

  /* Móvil: título; Juan | J RA; Virginia; Sergio | Cristobal; Sandra; Pedro | foto. */
  .o-titulo, .o-virginia, .o-sandra { grid-column: 1 / -1; }
  /* Móviles estrechos: cada reseña a lo ancho (en 140 px quedaban tres palabras por línea). */
  @media (max-width: 379px) {
    .o-resena { grid-column: 1 / -1; }
    .o-foto { grid-column: 1 / -1; aspect-ratio: 4 / 3; }
  }

  @media (min-width: 900px) {
    .o-titulo { grid-column: 1; grid-row: 1 / 3; }
    .o-juan { grid-column: 2; grid-row: 1; }
    .o-cristobal { grid-column: 3; grid-row: 1; }
    .o-sergio { grid-column: 2; grid-row: 2; }
    .o-jra { grid-column: 3; grid-row: 2; }
    .o-foto { grid-column: 4; grid-row: 1 / 3; min-height: 24rem; }

    .o-virginia { grid-column: 1 / 3; grid-row: 3; }
    .o-sandra { grid-column: 3; grid-row: 3; }
    .o-pedro { grid-column: 4; grid-row: 3; }
  }
</style>
