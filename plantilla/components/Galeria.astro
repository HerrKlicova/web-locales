---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Foto { src: ImageMetadata; alt: string }
interface Props {
  titulo?: string;
  fotos: Foto[]; // la primera se muestra en grande
}
const { titulo = 'El local', fotos } = Astro.props;
const [principal, ...resto] = fotos;
---

<section id="fotos" aria-labelledby="fotos-titulo" class="bg-verde px-4 py-16 text-marfil sm:px-8 md:py-24">
  <div class="mx-auto max-w-6xl">
    <h2 id="fotos-titulo" class="reveal m-0 font-rotulo text-4xl font-black text-oro sm:text-5xl">{titulo}</h2>

    <div class="reveal mt-8 grid grid-cols-2 gap-3 md:mt-10 md:h-[38rem] md:grid-cols-3 md:grid-rows-2">
      {
        principal && (
          <figure class="m-0 col-span-2 aspect-[4/3] md:col-span-1 md:row-span-2 md:aspect-auto">
            <Picture
              src={principal.src}
              alt={principal.alt}
              formats={['avif', 'webp']}
              widths={[480, 760, 1000]}
              sizes="(min-width: 768px) 33vw, 100vw"
              loading="lazy"
              decoding="async"
              pictureAttributes={{ class: 'block h-full' }}
              class="block h-full w-full object-cover"
            />
          </figure>
        )
      }
      {
        resto.map((f) => (
          <figure class="m-0 aspect-square md:col-span-2 md:aspect-auto md:min-h-0">
            <Picture
              src={f.src}
              alt={f.alt}
              formats={['avif', 'webp']}
              widths={[480, 760, 1000, 1400]}
              sizes="(min-width: 768px) 66vw, 50vw"
              loading="lazy"
              decoding="async"
              pictureAttributes={{ class: 'block h-full' }}
              class="block h-full w-full object-cover"
            />
          </figure>
        ))
      }
    </div>
  </div>
</section>
