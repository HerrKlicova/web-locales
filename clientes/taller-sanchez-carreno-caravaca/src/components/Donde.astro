---
import { enlaceWhatsapp } from '@plantilla/lib/ficha';
import type { Ficha } from '@plantilla/lib/ficha';
import Icono from './Icono.astro';
import plano from './plano.json';

/**
 * Dónde está. El plano es propio: las calles reales de Caravaca sacadas de OpenStreetMap
 * (mapa/plano.mjs), en gris sobre negro, con la carretera de Granada en blanco, el taller en rojo
 * y el Santuario de la Vera Cruz de referencia, que es por donde se orienta cualquiera en Caravaca.
 * No carga nada de fuera ni pone cookies. El piloto del taller se enciende al llegar (CSS atado al
 * scroll: si ya has pasado, está encendido).
 *
 * «Cómo llegar» abre la ruta en Google Maps hasta su ficha. No hay foto de fachada: las que hay son
 * generadas y aquí es donde alguien busca reconocer el sitio desde la calle.
 */
interface Props { ficha: Ficha & { place_id?: string } }
const { ficha } = Astro.props;
const whatsapp = enlaceWhatsapp(ficha, 'Hola, quería pedir cita para el coche.');
const [lat, lng] = ficha.coordenadas;
const ruta = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}${ficha.place_id ? `&destination_place_id=${ficha.place_id}` : ''}`;
const { lado, taller, santuario, capas } = plano as { lado: number; taller: [number, number]; santuario: [number, number]; capas: Record<string, string> };
const pct = ([x, y]: [number, number]) => `left:${((x / lado) * 100).toFixed(2)}%;top:${((y / lado) * 100).toFixed(2)}%`;
---

<section id="donde" class="donde" aria-labelledby="donde-titulo">
  <div class="donde-texto margen">
    <h2 id="donde-titulo" class="ancha m-0 text-[clamp(2.1rem,4.4vw,4.4rem)]">Dónde estamos</h2>
    <address class="mt-8 text-xl not-italic leading-snug sm:text-2xl">
      {ficha.nombre}<br />{ficha.direccion}<br />{ficha.cp} {ficha.pueblo}
    </address>
    <p class="m-0 mt-4 max-w-[36ch] text-niebla">En la carretera de Granada, a la salida de Caravaca.</p>
    <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a href={ruta} class="boton boton-blanco" target="_blank" rel="noopener">
        <Icono nombre="ruta" class="size-5" />
        Cómo llegar
      </a>
      <a href={whatsapp} class="boton boton-linea" target="_blank" rel="noopener">
        <Icono nombre="whatsapp" class="size-5.5" />
        Escribir por WhatsApp
      </a>
    </div>
    <p class="m-0 mt-6">
      <a href={ficha.maps_url} class="enlace inline-flex min-h-11 items-center text-niebla" target="_blank" rel="noopener">Abrir la ficha del taller en Google Maps</a>
    </p>
  </div>

  <figure class="donde-plano m-0">
    <svg viewBox={`0 0 ${lado} ${lado}`} class="absolute inset-0 h-full w-full" role="img" aria-label="Plano de Caravaca con el taller en la carretera de Granada, al sur del centro y del Santuario de la Vera Cruz">
      <g fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d={capas.rio} stroke="#141414" stroke-width="30" />
        <path d={capas.menor} stroke="#1d1d1d" stroke-width="5" />
        <path d={capas.calle} stroke="#303030" stroke-width="7" />
        <path d={capas.media} stroke="#404040" stroke-width="10" />
        <path d={capas.principal} stroke="#505050" stroke-width="12" />
        <path d={capas.autovia} stroke="#3c3c3c" stroke-width="18" />
        <path d={capas.granada} stroke="#f4f4f2" stroke-width="12" />
      </g>
      <circle cx={santuario[0]} cy={santuario[1]} r="13" fill="#f4f4f2" />
    </svg>
    <span class="plano-rotulo plano-rotulo--santuario" style={pct(santuario)} aria-hidden="true">Santuario de la Vera Cruz</span>
    {/* Junto a la carretera, 300 m al sur del taller (en y = 1700 la carretera pasa por x ≈ 675). */}
    <span class="plano-rotulo plano-rotulo--carretera" style={pct([taller[0] - 60, taller[1] + 300])} aria-hidden="true">Ctra. de Granada</span>
    <span class="plano-piloto" style={pct(taller)} aria-hidden="true"><span class="piloto-luz"></span><span class="piloto-onda"></span></span>
    <span class="plano-rotulo plano-rotulo--taller" style={pct(taller)} aria-hidden="true">Sánchez Carreño</span>
    <figcaption class="plano-credito">
      Plano: © <a href="https://www.openstreetmap.org/copyright" class="enlace" target="_blank" rel="noopener">colaboradores de OpenStreetMap</a>
    </figcaption>
  </figure>
</section>

<style>
  .donde { display: grid; background: var(--color-negro); border-top: 1px solid var(--color-grafito); }
  .donde-texto { padding-block: clamp(5rem, 14svh, 9rem); }
  .donde-plano { position: relative; aspect-ratio: 1; overflow: hidden; background: var(--color-negro); }
  @media (min-width: 900px) {
    .donde { grid-template-columns: 1fr 1fr; }
    .donde-texto { align-self: center; }
    .donde-plano { border-left: 1px solid var(--color-grafito); }
  }

  .plano-rotulo {
    position: absolute;
    font-size: clamp(0.72rem, 1.05vw, 0.9rem);
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
  }
  .plano-rotulo--santuario { color: var(--color-niebla); translate: -50% 0.9rem; }
  .plano-rotulo--carretera { color: var(--color-niebla); translate: 0.6rem -50%; }
  .plano-rotulo--taller {
    font-weight: 600;
    color: var(--color-blanco);
    background: rgb(0 0 0 / 0.8);
    padding: 0.3em 0.75em;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(244 244 242 / 0.16);
    translate: calc(-100% - 1.1rem) -50%;
  }
  .plano-credito {
    position: absolute;
    right: 0.75rem;
    bottom: 0.6rem;
    font-size: 0.72rem;
    color: var(--color-humo);
  }
  .plano-credito a { color: inherit; }

  /* El piloto del taller: un punto gris apagado y, encima, la luz roja con su halo. Solo se
     anima la opacidad y la escala de la luz (§7). */
  .plano-piloto {
    position: absolute;
    width: 0.95rem;
    height: 0.95rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: #3a3a3a;
  }
  .piloto-luz, .piloto-onda { position: absolute; inset: 0; border-radius: 50%; }
  .piloto-luz {
    background: #ff4a3f;
    box-shadow: 0 0 0 3px rgb(210 16 26 / 0.45), 0 0 16px 3px rgb(255 51 38 / 0.8), 0 0 42px 10px rgb(255 51 38 / 0.25);
  }
  /* El pulso: una onda que sale del piloto cada poco, la señal de «estás aquí». Es un movimiento
     continuo, así que va solo sin movimiento reducido (§7). */
  .piloto-onda { inset: -0.4rem; box-shadow: 0 0 0 1.5px rgb(255 51 38 / 0.7); opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .piloto-onda { animation: onda 2.6s var(--ease-out) 1s infinite; }
  }
  @keyframes onda {
    0% { transform: scale(0.6); opacity: 0.9; }
    100% { transform: scale(3.2); opacity: 0; }
  }
  /* Se enciende al entrar en pantalla, con un destello corto como un filamento (el mismo gesto
     de toda la web). Sin soporte, ya está encendido. */
  @supports (animation-timeline: view()) {
    .piloto-luz {
      animation: piloto linear both;
      animation-timeline: view();
      animation-range: entry 40% cover 45%;
    }
  }
  @keyframes piloto {
    0%, 55% { opacity: 0; transform: scale(0.7); }
    62% { opacity: 1; transform: scale(1.35); }
    100% { opacity: 1; transform: scale(1); }
  }
</style>
