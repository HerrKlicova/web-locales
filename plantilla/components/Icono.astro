---
/** Iconos SVG de trazo. Nunca emojis (§3). */
interface Props { nombre: 'whatsapp' | 'telefono' | 'pin' | 'reloj' | 'estrella' | 'ruta' | 'mapa' | 'google'; class?: string }
const { nombre, class: clase = 'size-5' } = Astro.props;
---
