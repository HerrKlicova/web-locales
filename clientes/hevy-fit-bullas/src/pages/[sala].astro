---
// Página propia de cada sala: su bloque completo y todas sus fotos. La luz de la sala tiñe el fondo desde el principio.
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Cabecera from '../components/Cabecera.astro';
import Sala from '../components/Sala.astro';
import Footer from '../components/Footer.astro';
import BarraFija from '../components/BarraFija.astro';
import { HORARIOS, type FichaHevy } from '../lib/datos';
import { FOTOS, RECORRIDOS } from '../lib/fotos';
import fichaJson from '../../ficha.json';

export function getStaticPaths() {
  const ficha = fichaJson as unknown as FichaHevy;
  return ficha.actividades.map((a) => ({ params: { sala: a.id }, props: { actividad: a } }));
}

const ficha = fichaJson as unknown as FichaHevy;
const { actividad } = Astro.props;
const horario = HORARIOS.find((h) => h.id === actividad.id);
const fotos = FOTOS[actividad.id];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const titulo = `${actividad.nombre} en ${ficha.pueblo} — ${ficha.marca}`;
const descripcion = `${actividad.texto} Tarifas, horario y fotos de la sala. Inscríbete en hevyfitbullas.es o pregunta por WhatsApp.`;
const demo = import.meta.env.PRODUCCION !== 'true';
---

<Layout titulo={titulo} descripcion={descripcion} demo={demo} sala={actividad.id}>
  <Cabecera ficha={ficha} />

  <main id="contenido">
    <p class="mx-auto max-w-6xl px-4 pt-4 sm:px-8">
      <a href={`${base}/`} class="inline-flex min-h-11 items-center text-hueso-tenue hover:text-hueso">Volver a la portada</a>
    </p>

    <Sala ficha={ficha} actividad={actividad} horario={horario} fotos={fotos} recorrido={RECORRIDOS[actividad.id]} />

    <section aria-labelledby="fotos-titulo" class={`luz-${actividad.luz} px-4 pb-16 sm:px-8 md:pb-24`}>
      <div class="mx-auto max-w-6xl">
        <h2 id="fotos-titulo" class="rotulo m-0 text-3xl sm:text-4xl">La sala en fotos</h2>
        <ul class="escalonado mt-8 grid list-none grid-cols-2 gap-3 p-0 md:grid-cols-3 md:gap-4">
          {
            fotos.map((f) => (
              <li class:list={['foto-zoom overflow-hidden', actividad.id === 'barre' ? 'arco' : 'rounded-xl']}>
                <Picture
                  src={f.src}
                  alt={f.alt}
                  formats={['avif', 'webp']}
                  widths={[360, 540, 760, 1000]}
                  sizes="(min-width: 768px) 33vw, 50vw"
                  loading="lazy"
                  decoding="async"
                  pictureAttributes={{ class: 'block' }}
                  class="block aspect-[3/4] h-auto w-full object-cover"
                />
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-hueso-tenue">Iremos añadiendo más fotos y vídeos de la sala.</p>
      </div>
    </section>
  </main>

  <Footer ficha={ficha} titular={ficha.titular} nif={ficha.nif} />
  <BarraFija ficha={ficha} />
</Layout>
