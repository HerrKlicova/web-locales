---
import { enlaceWhatsapp } from '@plantilla/lib/ficha';
import type { FichaHevy } from '../lib/datos';
import Icono from './Icono.astro';

/** Barra fija abajo en móvil, a partir de la primera pantalla (§8): reservar y WhatsApp. */
interface Props { ficha: FichaHevy }
const { ficha } = Astro.props;
const whatsapp = enlaceWhatsapp(ficha, `Hola, quiero información sobre ${ficha.marca}.`);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div
  class="barra-fija fixed inset-x-0 bottom-0 z-40 flex gap-2 border-t border-noche-borde bg-noche/95 p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur transition-transform duration-300 ease-out md:hidden"
  data-barra-fija
>
  <a
    href={`${base}/inscripcion/`}
    class="flex min-h-13 flex-1 items-center justify-center rounded-full bg-neon text-lg font-bold text-noche"
  >
    Inscribirme
  </a>
  <a
    href={whatsapp}
    class="flex min-h-13 flex-1 items-center justify-center gap-2 rounded-full border-2 border-noche-borde text-lg font-bold text-hueso"
    target="_blank"
    rel="noopener"
  >
    <Icono nombre="whatsapp" class="size-6" />
    WhatsApp
  </a>
</div>

<style>
  /* La clase la pone el observador de abajo. En CSS propio y no como utilidad suelta:
     así no depende de que el rastreador de Tailwind la encuentre dentro del script. */
  .barra-fija.escondida { transform: translateY(120%); }
</style>

<script>
  // Escondida mientras se ve el hero (ya tiene sus botones); aparece al pasar la primera pantalla.
  const barra = document.querySelector<HTMLElement>('[data-barra-fija]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (barra && hero && 'IntersectionObserver' in window) {
    // El hero ocupa toda la pantalla: basta con que asome un tercio para considerarlo a la vista.
    const io = new IntersectionObserver(([e]) => barra.classList.toggle('escondida', e.intersectionRatio > 0.3), {
      threshold: [0, 0.3, 0.6, 1],
    });
    io.observe(hero);
    barra.classList.add('escondida');
  }
</script>
