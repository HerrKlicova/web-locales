{
  // Proyecto de demos (§9): un Worker que sirve dist/demo/ como estáticos.
  // Cada cliente cuelga de /<slug>-<token>/. Se despliega con scripts/demo.mjs.
  // El código del Worker (scripts/worker-demo.mjs) solo añade soporte de peticiones parciales para los vídeos.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webs-locales-demo",
  "main": "scripts/worker-demo.mjs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist/demo",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
